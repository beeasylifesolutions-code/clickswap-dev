// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per store that uses the app
model Shop {
  id          String    @id @default(cuid())
  domain      String    @unique
  // 1 = Starter, 2 = Growth, 3 = Scale, 4 = Enterprise
  plan        Int       @default(1)
  swapEnabled Boolean   @default(false)
  consentAt   DateTime?
  // The store's own category (required to take part in the swap).
  // Other stores can block a whole category.
  niche       String?
  ordersLast30    Int       @default(0)
  ordersCheckedAt DateTime?
  // Merchant's global kill switch: turns everything off
  killSwitch  Boolean   @default(false)
  // Our own switch: we can turn a store off at once
  suspended       Boolean @default(false)
  suspendedReason String?
  // Categories this store never wants to see ads from
  blockedCategories String[] @default([])
  // Off by default: adult and restricted stores are hidden from this store
  showRestricted Boolean @default(false)
    pinnedOnly      Boolean  @default(false)
  // Set once the store has shown its first 5 valid network ads
  poolEligibleAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ads            Ad[]
  slots          Slot[]
  pinnedStores   PinnedStore[]
  ownEvents      OwnEvent[]
  blockedStores  BlockedStore[]
  reports        Report[]
  ledger         CreditLedger[]
  clicksSent     Click[]        @relation("ClicksSent")
  clicksReceived Click[]        @relation("ClicksReceived")
}

// The ad a store wants partner stores to show (one of its products)
model Ad {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  text        String
  destination String
  code        String?
  imageUrl    String?
  priceText   String?
  productGid  String?
  // The merchant's own on/off switch
  active      Boolean  @default(true)
  // Our switch: set by us or by repeated reports
  disabled       Boolean @default(false)
  disabledReason String?
  createdAt   DateTime @default(now())

  clicks  Click[]
  reports Report[]

  @@index([shopId])
}

// One of the 6 display slots: 3 on each page
model Slot {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // "order_confirmation" or "thank_you"
  surface    String
  // 1, 2 or 3
  position   Int
  // "self_promo", "swap_first" or "locked_store"
  mode       String   @default("self_promo")
  active     Boolean  @default(true)
  // The store's own product shown in this slot (Product A)
  productGid String?
  title      String?
  imageUrl   String?
  priceText  String?
  productUrl String?
  // For locked_store mode: the partner store pinned here
  lockedDomain String?
  // A/B test: when abActive is true, shoppers are split between A and B
  abActive      Boolean   @default(false)
  abStartedAt   DateTime?
  bProductGid   String?
  bTitle        String?
  bImageUrl     String?
  bPriceText    String?
  bProductUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shopId, surface, position])
}

// A partner store this store never wants to see
model BlockedStore {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  domain    String
  createdAt DateTime @default(now())

  @@unique([shopId, domain])
}

// A merchant flagging a partner ad
model Report {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  adId       String
  ad         Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  reason     String
  note       String?
  // "open", "reviewed", "dismissed" or "actioned"
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([adId])
  @@index([status, createdAt])
}

// One row per click on a partner ad. The token can only be used once.
model Click {
  id               String    @id @default(cuid())
  token            String    @unique
  adId             String
  ad               Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  senderShopId     String
  sender           Shop      @relation("ClicksSent", fields: [senderShopId], references: [id], onDelete: Cascade)
  advertiserShopId String
  advertiser       Shop      @relation("ClicksReceived", fields: [advertiserShopId], references: [id], onDelete: Cascade)
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  usedAt           DateTime?
  settleAfter      DateTime?
  settledAt        DateTime?
  // Groups the ads shown together on one page view
  viewId           String?
  // Order ID plus hashed session, so one checkout counts one click
  dedupeKey        String?

  @@index([senderShopId, createdAt])
  @@index([advertiserShopId, createdAt])
  @@index([status, settleAfter])
  @@index([senderShopId, viewId])
  @@index([dedupeKey])
}

// A running list of credits earned (+) and spent (-)
model CreditLedger {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  clickId   String?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

// A partner store this store wants to see first
model PinnedStore {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  domain    String
  createdAt DateTime @default(now())

  @@unique([shopId, domain])
}

// Views and clicks on a store's OWN products (not partner ads)
model OwnEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // "order_confirmation" or "thank_you"
  surface   String
  // "view" or "click"
  kind      String
  slotId    String?
  title     String?
  // A/B test: "a" or "b" (empty when no test was running)
  variant   String?
  // Hashed order id, so one order counts as one view
  orderKey  String?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, surface, orderKey])
}

// Scratch ticket / surprise gift rewards
model Reward {
  id        String        @id @default(cuid())
  shopId    String
  kind      String // "scratch" or "gift"
  title     String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  prizes    RewardPrize[]
  plays     RewardPlay[]

  @@index([shopId])
}

model RewardPrize {
  id        String   @id @default(cuid())
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  label     String // what the shopper sees, e.g. "10% off your next order"
  code      String? // the discount code made in Shopify
  weight    Int      @default(1) // bigger number = wins more often
  createdAt DateTime @default(now())
}

model RewardPlay {
  id        String   @id @default(cuid())
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  orderKey  String // hashed order reference, never the real order number
  prizeId   String
  createdAt DateTime @default(now())

  @@unique([rewardId, orderKey])
}

// Customer survey (one per store, anonymous answers)
model Survey {
  id        String         @id @default(cuid())
  shopId    String         @unique
  question  String
  options   String[]
  active    Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  answers   SurveyAnswer[]
}

model SurveyAnswer {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  orderKey  String // hashed order reference, never the real order number
  question  String // the question as it was when answered
  answer    String
  createdAt DateTime @default(now())

  @@unique([surveyId, orderKey])
  @@index([surveyId, createdAt])
}